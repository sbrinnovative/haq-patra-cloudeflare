{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haq-patra-cloudeflare",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" }
}
